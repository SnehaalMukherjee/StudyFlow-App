# Copy to .env and fill from Supabase Dashboard → Settings → API (same project for all values).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# AI Tools — FREE (Supabase Edge Function; keys stay server-side, not in .env)
# Recommended: Groq (generous free tier) — https://console.groq.com → API Keys
#   GROQ_API_KEY=gsk_...
# Optional fallback: Gemini — https://aistudio.google.com/apikey
#   GEMINI_API_KEY=...
# Supabase Dashboard → Project Settings → Edge Functions → Secrets → add key(s)
# Deploy: npx supabase functions deploy ai-tools --project-ref YOUR_PROJECT_REF
